// RST AIセミナー ハンズオン環境
// 設計方針: 壊れる可能性のある指定を極力書かない
//   - remoteUser を書かない       → イメージ既定のユーザーを使う（$HOME 不一致事故を防ぐ）
//   - hostRequirements を書かない → 無料枠のマシンで確保できずに詰まるのを防ぐ
//   - features を使わない         → ビルド時間と失敗要因を増やさない
{
  "name": "RST AI Seminar",

  // Node 22 系の devcontainer イメージ。
  // claude-code が Node>=22 を要求するため、Node 22 を確定的に積むこのイメージを使う。
  // （universal:2 は既定 Node が 20 で、npm install 時に EBADENGINE 警告が出るため不採用。
  //   tag 自体は pull 可能。経緯は HANDOFF.md の 2-6 / 6 を参照）
  // 万一この tag が引けない場合は、Node 22 を積む別イメージに差し替える（Node 22 未満に落とさないこと）:
  //   "mcr.microsoft.com/devcontainers/javascript-node:22"   (同等・タグ違い)
  //   "mcr.microsoft.com/devcontainers/typescript-node:1-22" (同等＋TypeScript同梱)
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22",

  // onCreateCommand は Prebuild に取り込まれる。
  // Prebuild を有効化すると、この npm install が事前に済んだ状態で配布できる。
  "onCreateCommand": "bash .devcontainer/bootstrap.sh",

  // 接続のたびに状態を表示。失敗してもコンテナは落とさない。
  "postAttachCommand": "bash scripts/doctor.sh || true",

  // 3000 は preview.py（作ったアプリのプレビュー）が使う。
  // forwardPorts に書いたポートはコンテナ起動時に無条件で転送されるため、
  // 自動検知の成否に依存せず確実にブラウザから開ける。
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "アプリのプレビュー",
      // "notify" = 右下に「ブラウザーで開く」の通知を出す。受講生はこれを押す。
      //   - "silent"      は通知が出ず、受講生がプレビューに気づけない（旧設定）
      //   - "openPreview" はエディタ内蔵ブラウザ（iframe）で開くが、Codespaces の
      //     private ポートは GitHub 認証のリダイレクトが iframe 内で完結できず
      //     401 になる既知の問題があるため使わない。
      //     実ブラウザのタブ（トップレベル遷移）なら認証が正常に通る。
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "editor.formatOnSave": false
      },
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
      // 注意: Claude Code の VS Code 拡張 "anthropic.claude-code" はあえて入れていない。
      // 拡張は既定で Anthropic アカウントへのログインを促すため、
      // APIキー運用の本セミナーでは受講生が「サインインを求められて詰まる」事故が起きる。
      // CLI（claude コマンド）で統一する。詳細は docs/operator-guide.md
    }
  }
}
